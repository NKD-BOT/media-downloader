# ---- Telegram (get API_ID / API_HASH from https://my.telegram.org) ----
API_ID=
API_HASH=
BOT_TOKEN=

# ---- Access control ----
OWNER_ID=
# Comma-separated Telegram user IDs allowed to use /leech.
# Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=

# ---- Storage / limits ----
DOWNLOAD_DIR=downloads
# Telegram per-file cap for a normal (non-Premium) account via MTProto is
# ~2000 MiB. Files larger than this are split into parts (see SPLIT_SIZE_MB).
MAX_FILE_SIZE_MB=1990
# Size of each part when splitting an oversized file. Set to 0 to disable
# splitting entirely (oversized files are then just refused).
SPLIT_SIZE_MB=1990
REQUEST_TIMEOUT_SECONDS=3600
CONNECT_TIMEOUT_SECONDS=30
SOCK_READ_TIMEOUT_SECONDS=120

# ---- Torrent / magnet support ----
# Requires the `aria2c` binary on the host (already installed in the
# provided Dockerfile). If it's missing, the bot still runs fine -- only
# /leech with a magnet/.torrent source will report a clear error.
# ---- Torrent / magnet support (via a local aria2c daemon) ----
# Master on/off switch. Set to false to fully disable magnet/torrent
# leeching -- aria2c is never even started, so no P2P/DHT/BitTorrent
# traffic goes out at all. Turn this OFF on hosts whose acceptable-use
# policy disallows torrenting (e.g. Railway) to avoid getting your
# workspace restricted. Direct-link /leech keeps working either way.
TORRENT_ENABLED=true
ARIA2_RPC_PORT=6800
ARIA2_RPC_SECRET=
TORRENT_METADATA_TIMEOUT_SECONDS=60

# ---- Leech Settings (/usetting) ----
# Path to the JSON file storing each user's prefix/suffix/caption/
# thumbnail/metadata/dump/name-swap preferences. No external DB needed.
SETTINGS_DB_PATH=user_settings.json
# Metadata-title embedding (the "Metadata" button) requires the `ffmpeg`
# binary on the host (already installed in the provided Dockerfile). If
# it's missing, that one feature is silently skipped -- everything else
# still works.
